# macOS
.DS_Store

# Claude Code local state / worktrees
.claude/
**/.claude/

# openFrameworks build output
example/obj/
example/bin/example.app/
example/openFrameworks-Info.plist

# Scratch / generated output
tmp/
output/
__pycache__/
*.pyc

# SuperCollider build output (binaries live in the app data folder)
synthdefs/**/CompiledSynthdefs/

# Built UGen plugins: our own are committed (a clone needs them and building
# them takes a SuperCollider source checkout); anything else built here is not
ugens/**/*.scx
!ugens/OceanodeAnalog/OceanodeAnalog.scx
!ugens/OceanodeSpectral/OceanodeSpectral.scx

!ugens/OceanodeSteamPipe/OceanodeSteamPipe.scx
!ugens/OceanodePrimitives/OceanodePrimitives.scx
